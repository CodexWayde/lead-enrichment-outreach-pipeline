        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"llama-3.3-70b-versatile\",\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are a sales research assistant. Summarize the company info into: 1) What they do, 2) A likely pain point our outreach could address, 3) One personalization hook. Keep it under 100 words total.\"\n    },\n    {\n      role: \"user\",\n      content: \"Company: \" + $json.company_name + \"\\n\\nSearch results:\\n\" + $json.search_snippets\n    }\n  ]\n}) }}",
