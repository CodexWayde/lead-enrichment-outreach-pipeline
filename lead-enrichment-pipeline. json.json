    {
      "parameters": {
        "jsCode": "const results = $input.first().json.organic || [];\n\nconst snippets = results.slice(0, 5).map(r => \n  `${r.title}: ${r.snippet}`\n).join('\\n');\n\nreturn [{\n  json: {\n    ...$('Filter').item.json,\n    search_snippets: snippets\n  }\n}];"
      },
